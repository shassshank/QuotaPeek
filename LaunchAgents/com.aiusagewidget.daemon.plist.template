<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiusagewidget.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Log rotation wrapper: checks log size before exec'ing the real
             binary. Rotates/truncates if over 5 MB, keeping one prior copy. -->
        <string>__BIN_DIR__/run-with-log-rotation.sh</string>
        <string>__APP_SUPPORT__/daemon.log</string>
        <string>__BIN_DIR__/aiusaged</string>
    </array>
    <!-- KeepAlive means launchd restarts the daemon if it ever dies unexpectedly.
         Quitting the app also unloads this agent (main.swift's quitAndStopDaemon),
         so the only way this stays running past that is install.sh --daemon-stop
         being used to unload it separately, or --daemon-start to reload it. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__APP_SUPPORT__/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>__APP_SUPPORT__/daemon.log</string>
</dict>
</plist>
