<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiusagewidget.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Log rotation wrapper: checks log size before exec'ing the real
             binary. Rotates/truncates if over 5 MB, keeping one prior copy. -->
        <string>__BIN_DIR__/run-with-log-rotation.sh</string>
        <string>__APP_SUPPORT__/daemon.log</string>
        <string>__BIN_DIR__/aiusaged</string>
    </array>
    <!-- Independent of app login/quit. Explicit stop: install.sh --daemon-stop (unload -w). -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__APP_SUPPORT__/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>__APP_SUPPORT__/daemon.log</string>
</dict>
</plist>
