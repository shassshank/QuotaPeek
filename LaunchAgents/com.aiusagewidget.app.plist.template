<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiusagewidget.app</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BIN_DIR__/AIUsageWidget</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__APP_SUPPORT__/app.log</string>
    <key>StandardErrorPath</key>
    <string>__APP_SUPPORT__/app.log</string>
</dict>
</plist>
